import javax.microedition.midlet.*;
import javax.microedition.lcdui.*;
import java.util.Random;

public class BatterySnake extends MIDlet implements CommandListener {
    private Display display;
    private SnakeCanvas canvas;
    private Command exitCommand;

    public void startApp() {
        display = Display.getDisplay(this);
        canvas = new SnakeCanvas();
        exitCommand = new Command("Выход", Command.EXIT, 1);
        canvas.addCommand(exitCommand);
        canvas.setCommandListener(this);
        display.setCurrent(canvas);
        new Thread(canvas).start(); // Запускаем игровой цикл
    }

    public void pauseApp() {}
    public void destroyApp(boolean unconditional) {}

    public void commandAction(Command c, Displayable d) {
        if (c == exitCommand) {
            destroyApp(false);
            notifyDestroyed();
        }
    }
}

class SnakeCanvas extends Canvas implements Runnable {
    private int width, height;
    private int[] snakeX, snakeY;
    private int snakeLength;
    private int foodX, foodY;
    private int direction = 1; // 1=вверх, 2=вниз, 3=влево, 4=вправо
    private boolean gameOver = false;
    private int batteryLevel = 100;
    private Random random = new Random();
    private boolean running = true;

    public SnakeCanvas() {
        width = getWidth();
        height = getHeight();
        startGame();
    }

    private void startGame() {
        snakeX = new int[200];
        snakeY = new int[200];
        snakeLength = 3;
        snakeX[0] = width / 2; snakeY[0] = height / 2 + 20;
        snakeX[1] = width / 2; snakeY[1] = height / 2 + 30;
        snakeX[2] = width / 2; snakeY[2] = height / 2 + 40;
        spawnFood();
        batteryLevel = 100;
        gameOver = false;
        direction = 1; 
    }

    private void spawnFood() {
        foodX = (random.nextInt(width / 10) * 10) + 5;
        foodY = (random.nextInt(height / 10) * 10) + 5;
    }

    protected void paint(Graphics g) {
        // Белый фон
        g.setColor(255, 255, 255);
        g.fillRect(0, 0, width, height);
        g.setColor(0, 0, 0); // Черный текст

        if (gameOver) {
            g.drawString("БАТАРЕЯ СЕЛА", width/2, height/2 - 20, Graphics.HCENTER | Graphics.TOP);
            g.drawString("Игра окончена", width/2, height/2, Graphics.HCENTER | Graphics.TOP);
            g.drawString("Нажми ОК", width/2, height/2 + 20, Graphics.HCENTER | Graphics.TOP);
            return;
        }

        // Верхняя панель: статус батареи
        g.drawString("Заряд: " + batteryLevel + "%", 5, 5, Graphics.LEFT | Graphics.TOP);
        g.drawLine(0, 20, width, 20); // Линия-разделитель

        // Змейка (темно-зеленая)
        g.setColor(0, 120, 0);
        for (int i = 0; i < snakeLength; i++) {
            g.fillRect(snakeX[i], snakeY[i], 8, 8);
        }

        // Еда (заряд, ярко-зеленый)
        g.setColor(0, 255, 0);
        g.fillRect(foodX, foodY, 8, 8);
    }

    public void keyPressed(int keyCode) {
        int action = getGameAction(keyCode);
        
        if (gameOver && action == FIRE) {
            startGame();
            return;
        }

        if (action == UP && direction != 2) direction = 1;
        if (action == DOWN && direction != 1) direction = 2;
        if (action == LEFT && direction != 4) direction = 3;
        if (action == RIGHT && direction != 3) direction = 4;
    }

    public void run() {
        while (running) {
            try {
                if (!gameOver) {
                    updateGame();
                }
                repaint();
                Thread.sleep(250); // Скорость. Уменьши до 150 для хардкора
            } catch (InterruptedException e) {}
        }
    }

    private void updateGame() {
        // Движение хвоста
        for (int i = snakeLength - 1; i > 0; i--) {
            snakeX[i] = snakeX[i - 1];
            snakeY[i] = snakeY[i - 1];
        }

        // Движение головы
        if (direction == 1) snakeY[0] -= 10;
        if (direction == 2) snakeY[0] += 10;
        if (direction == 3) snakeX[0] -= 10;
        if (direction == 4) snakeX[0] += 10;

        // Стены
        if (snakeX[0] < 0 || snakeX[0] >= width - 5 || snakeY[0] < 20 || snakeY[0] >= height - 5) {
            gameOver = true;
            return;
        }

        // Врезались в себя
        for (int i = 1; i < snakeLength; i++) {
            if (snakeX[0] == snakeX[i] && snakeY[0] == snakeY[i]) {
                gameOver = true;
                return;
            }
        }

        // Съели заряд
        if (Math.abs(snakeX[0] - foodX) < 10 && Math.abs(snakeY[0] - foodY) < 10) {
            snakeLength++;
            spawnFood();
            batteryLevel = Math.min(100, batteryLevel + 5); // Бонус
        } else {
            // Штраф за время
            if (random.nextInt(15) == 0) {
                batteryLevel--;
                if (batteryLevel <= 0) gameOver = true;
            }
        }
    }
}
